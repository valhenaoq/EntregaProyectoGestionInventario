# Puerto en el que escucha la API
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=gestion_inventario

# Secreto para firmar los JWT: usa una cadena larga y aleatoria (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
